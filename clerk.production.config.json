{
  "auth_email": {
    "used_for_sign_in": true,
    "used_for_sign_up": true,
    "required_for_sign_up": true,
    "verify_at_sign_up": true
  },
  "auth_phone": {
    "used_for_sign_in": false,
    "used_for_sign_up": false,
    "required_for_sign_up": false,
    "verify_at_sign_up": false,
    "used_for_second_factor": false,
    "sign_in_strategies": [],
    "second_factor_strategies": [],
    "verification_strategies": []
  },
  "auth_username": {
    "used_for_sign_in": false,
    "used_for_sign_up": false,
    "required_for_sign_up": false
  },
  "auth_password": {
    "enabled": true,
    "required": true,
    "min_length": 15,
    "disable_hibp": false,
    "enforce_hibp_on_sign_in": true,
    "disable_password_reverification": false,
    "device_trust": { "enabled": true }
  },
  "billing": {
    "user_enabled": false,
    "organization_enabled": false
  },
  "paths": {
    "home": "/",
    "sign_in": "/sign-in",
    "sign_up": "/sign-up",
    "after_sign_out_all": "/"
  },
  "compliance": {
    "legal_consent": {
      "enabled": true,
      "terms_of_service_url": "https://ticketsafe.ezrefillny.net/legal/terms",
      "privacy_policy_url": "https://ticketsafe.ezrefillny.net/legal/privacy"
    }
  }
}
