# Exact website origin, including port during development.
APP_ORIGIN=http://localhost:3000
# The existing Supabase project. Only its publishable key is exposed to clients.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Optional public map token.
MAPBOX_PUBLIC_TOKEN=
# Optional city-data and search protection services.
SOCRATA_APP_TOKEN=
NYC_GEOCLIENT_KEY=
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=
# Enable both only after the service-only Supabase ledger migration/function.
SEARCH_VERIFICATION_SECRET=
SEARCH_VERIFICATION_LEDGER_URL=
# Email delivery secrets belong in Supabase Edge Functions, never in Vercel/browser config.
